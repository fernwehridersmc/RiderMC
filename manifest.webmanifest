{
  "name": "Diário de Estrada · Fernweh Riders",
  "short_name": "Diário Fernweh",
  "description": "Diário de viagens de moto do casal Fernweh Riders (P&D)",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0F171D",
  "theme_color": "#0E5C46",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./receber-gpx",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "gpx",
          "accept": [
            ".gpx",
            "application/gpx+xml",
            "application/gpx",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "id": "./"
}